@prefix dkgm:    <https://w3id.org/ontouml/directkg/vocab#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

dcterms:title       rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator     rdf:type owl:AnnotationProperty .
dcterms:license     rdf:type owl:AnnotationProperty .
dcterms:created     rdf:type owl:AnnotationProperty .
dcterms:modified    rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri    rdf:type owl:AnnotationProperty .
skos:definition     rdf:type owl:AnnotationProperty .

<https://w3id.org/ontouml/directkg/vocab>
    rdf:type owl:Ontology ;
    owl:versionIRI <https://w3id.org/ontouml/directkg/vocab/1.0> ;
    owl:versionInfo "1.0" ;
    dcterms:title "DirectKG Mereology Vocabulary"@en ;
    dcterms:description
        "Reusable generic OWL properties for DirectKG mappings of four OntoUML mereological relation stereotypes."@en ;
    rdfs:comment
        "Source-specific relations generated by DirectKG can be subproperties of these generic properties. This vocabulary is not the OntoUML metamodel vocabulary."@en ;
    vann:preferredNamespacePrefix "dkgm" ;
    vann:preferredNamespaceUri "https://w3id.org/ontouml/directkg/vocab#" ;
    dcterms:creator <https://orcid.org/0000-0003-2736-7817> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-09-28T12:19:26+02:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-28T10:49:25Z"^^xsd:dateTime .

<https://orcid.org/0000-0003-2736-7817>
    rdfs:label "Pedro Paulo Favato Barcelos" .

dkgm:memberOf
    rdf:type owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    skos:definition "Relates a member to a collective of which it is a member."@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «memberOf» stereotype."@en ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/memberOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:memberOf dkgm:subCollectionOf ) .

dkgm:subCollectionOf
    rdf:type owl:ObjectProperty ;
    rdfs:label "subcollection of"@en ;
    skos:definition "Relates a collective to a collective of which it is a subcollection."@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «subCollectionOf» stereotype."@en ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/subCollectionOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:subCollectionOf dkgm:subCollectionOf ) .

dkgm:subQuantityOf
    rdf:type owl:ObjectProperty ;
    rdfs:label "subquantity of"@en ;
    skos:definition "Relates a quantity to a quantity of which it is a subquantity."@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «subQuantityOf» stereotype."@en ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/subQuantityOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:subQuantityOf dkgm:subQuantityOf ) .

dkgm:componentOf
    rdf:type owl:ObjectProperty ;
    rdfs:label "component of"@en ;
    skos:definition "Relates a functional complex to a functional complex of which it is a component."@en ;
    rdfs:comment
        "Generic DirectKG property corresponding to the OntoUML «componentOf» stereotype. Transitivity is not asserted because it depends on context."@en ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/componentOf/index.html> .