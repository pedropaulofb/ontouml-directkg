@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dkgm: <https://w3id.org/directkg/vocab/dkgm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dkgm:componentOf a owl:ObjectProperty ;
    rdfs:label "component of"@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «componentOf» stereotype. Transitivity is not asserted because it depends on context."@en ;
    rdfs:isDefinedBy <https://w3id.org/directkg/vocab/dkgm> ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/componentOf/index.html> ;
    skos:definition "Relates a functional complex to a functional complex of which it is a component."@en ;
    skos:scopeNote "The absence of a transitivity axiom leaves transitivity unspecified; it does not assert universal intransitivity."@en .

<https://orcid.org/0000-0003-2736-7817> rdfs:label "Pedro Paulo Favato Barcelos" .

dkgm:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «memberOf» stereotype."@en ;
    rdfs:isDefinedBy <https://w3id.org/directkg/vocab/dkgm> ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/memberOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:memberOf dkgm:subCollectionOf ) ;
    skos:definition "Relates a member to a collective of which it is a member."@en ;
    skos:example "Declaring ex:teamMembership rdfs:subPropertyOf dkgm:memberOf makes each ex:teamMembership statement a generic dkgm:memberOf statement. Generic membership alone does not entail ex:teamMembership."@en,
        "If ex:alice dkgm:memberOf ex:team and ex:team dkgm:subCollectionOf ex:organisation, the membership chain entails ex:alice dkgm:memberOf ex:organisation."@en ;
    skos:scopeNote "A conclusion inferred by a generic DKGM property chain uses the generic property; it does not identify a particular source-specific relationship."@en .

dkgm:subQuantityOf a owl:ObjectProperty ;
    rdfs:label "subquantity of"@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «subQuantityOf» stereotype."@en ;
    rdfs:isDefinedBy <https://w3id.org/directkg/vocab/dkgm> ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/subQuantityOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:subQuantityOf dkgm:subQuantityOf ) ;
    skos:definition "Relates a quantity to a quantity of which it is a subquantity."@en .

dkgm:subCollectionOf a owl:ObjectProperty ;
    rdfs:label "subcollection of"@en ;
    rdfs:comment "Generic DirectKG property corresponding to the OntoUML «subCollectionOf» stereotype."@en ;
    rdfs:isDefinedBy <https://w3id.org/directkg/vocab/dkgm> ;
    rdfs:seeAlso <https://ontouml.readthedocs.io/en/latest/relationships/aggregations/subCollectionOf/index.html> ;
    owl:propertyChainAxiom ( dkgm:subCollectionOf dkgm:subCollectionOf ) ;
    skos:definition "Relates a collective to a collective of which it is a subcollection."@en .

<https://w3id.org/directkg/vocab/dkgm> a owl:Ontology ;
    dcterms:created "2026-09-28T12:19:26+02:00"^^xsd:dateTime ;
    dcterms:creator <https://orcid.org/0000-0003-2736-7817> ;
    dcterms:description "Reusable generic OWL properties for DirectKG mappings of four OntoUML mereological relation stereotypes."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-23T19:30:12+00:00"^^xsd:dateTime ;
    dcterms:title "DirectKG Mereology Vocabulary"@en ;
    vann:preferredNamespacePrefix "dkgm" ;
    vann:preferredNamespaceUri "https://w3id.org/directkg/vocab/dkgm#" ;
    rdfs:comment "Source-specific relations generated by DirectKG can be subproperties of these generic properties. This vocabulary is not the OntoUML metamodel vocabulary."@en ;
    rdfs:seeAlso <https://w3id.org/directkg/docs>,
        <https://w3id.org/directkg/git> ;
    owl:priorVersion <https://w3id.org/directkg/vocab/dkgm/0.1.0> ;
    owl:versionIRI <https://w3id.org/directkg/vocab/dkgm/0.1.1> ;
    owl:versionInfo "0.1.1" ;
    skos:scopeNote "References to collectives, quantities and functional complexes in the definitions describe intended use; they are not formal RDF domain or range constraints."@en,
        "Source-specific properties may be asymmetric subproperties of DKGM properties. This does not make the generic DKGM properties asymmetric."@en .
