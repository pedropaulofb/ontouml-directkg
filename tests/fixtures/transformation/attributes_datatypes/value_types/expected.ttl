@prefix : <https://example.test/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<https://example.test/model> a owl:Ontology .

:cOwner a owl:Class ; rdfs:label "Owner" .
:cOther a owl:Class ; rdfs:label "Other" .
:pFocus a owl:DatatypeProperty ; rdfs:domain :cOwner ; rdfs:range xsd:int ; rdfs:label "focus" .
