@prefix : <https://example.test/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<https://example.test/model> a owl:Ontology .

:cOwner a owl:Class . :dAddress a owl:Class . :dLocation a owl:Class .
:pAddress a owl:ObjectProperty ; rdfs:domain :cOwner ; rdfs:range :dAddress .
:pStreet a owl:DatatypeProperty ; rdfs:domain :dAddress ; rdfs:range xsd:string .
:pLocation a owl:ObjectProperty ; rdfs:domain :dAddress ; rdfs:range :dLocation .
:pLatitude a owl:DatatypeProperty ; rdfs:domain :dLocation ; rdfs:range xsd:float .
