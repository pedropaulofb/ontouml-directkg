@prefix : <https://example.test/model#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:eStatus a owl:Class .
:vPending a owl:NamedIndividual, :eStatus ; rdfs:label "Pending" .
:vApproved a owl:NamedIndividual, :eStatus ; rdfs:label "Approved" .
:vClosed a owl:NamedIndividual, :eStatus ; rdfs:label "Closed" .
:pLegacy a owl:DatatypeProperty ; rdfs:domain :eStatus .
:pStatus a owl:ObjectProperty ; rdfs:domain :cOwner ; rdfs:range :eStatus .
