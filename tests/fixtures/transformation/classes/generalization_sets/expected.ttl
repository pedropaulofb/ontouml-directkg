@prefix : <https://example.test/model#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:cA a owl:Class .
:cB a owl:Class ; rdfs:subClassOf :cA .
:cC a owl:Class ; rdfs:subClassOf :cA .
:cD a owl:Class ; rdfs:subClassOf :cA .
:cE a owl:Class ; rdfs:subClassOf :cB .
:cF a owl:Class ; rdfs:subClassOf :cA .
